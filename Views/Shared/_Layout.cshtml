<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - btt2</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/btt2.styles.css" asp-append-version="true" />
</head>
<body>

    <header>
        <nav class="top-menu">
            <div class="menu-container">

                <a class="logo"
                   asp-controller="Home"
                   asp-action="Index">
                    MyAppMVC
                </a>

                <a asp-controller="Home"
                   asp-action="Index">
                    Trang chủ
                </a>

                <a href="#">
                    Giới thiệu
                </a>

                <a href="#">
                    Liên hệ
                </a>

                <a asp-controller="Product"
                   asp-action="Index">
                    Sản phẩm
                </a>

            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2021 - MyAppMVC</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
